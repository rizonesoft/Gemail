{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "noEmit": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["office-js", "jest", "node"]
  },
  "exclude": ["node_modules", "dist", "lib", "lib-amd", "build", "tools"],
  "ts-node": {
    "files": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node"
    }
  }
}
